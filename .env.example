BOT_TOKEN=your_telegram_bot_token
API_KEY=
SECRET_KEY=change_me_to_a_long_random_secret
DB_USER=postgres
DB_PASSWORD=change_me_strong_password
DB_NAME=logistika_db
DB_HOST=db
DB_PORT=5432
DB_URL=postgresql+asyncpg://postgres:change_me_strong_password@db:5432/logistika_db
# Telegram Web App (HTTPS)
WEBAPP_URL=https://example.org
# Postman / tashqi API (serverdagi nginx /api/ prefiksini backendga uzatadi)
API_PUBLIC_PREFIX=/api
# CORS uchun ruxsat etilgan originlar (vergul bilan ajratilgan). Bo'sh bo'lsa WEBAPP_URL ishlatiladi.
CORS_ORIGINS=https://example.org
# Admin Telegram ID(lar) — vergul bilan ajratiladi
ADMIN=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=1
ENVIRONMENT=production
LOG_LEVEL=INFO

# Test: haydovchi buyurtmalar ro'yxatida mashina turi filtrini o'chirish
# RELAX_DRIVER_ORDER_FILTERS=1

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=True

EMAIL_OTP_EXPIRE=120

# Redis (Docker compose service)
REDIS_HOST=logistika-redis
REDIS_PORT=6379
REDIS_DB=2

# ── RabbitMQ (haydovchi qidirish navbati) ────────────────────────────────────
# Xizmat nomi docker-compose tarmog'idagi "rabbitmq". Boshqaruv UI: :15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# Worker bir vaqtda nechta buyurtmani qidiradi (navbat prefetch cheklovi)
DISPATCH_PREFETCH=5
# Rejalashtirilgan buyurtma uchun qidiruv yuklashdan shuncha soat oldin boshlanadi
DISPATCH_LEAD_HOURS=24
# Sana taqqoslashlari uchun mintaqa (docker-compose'dagi TZ bilan bir xil)
APP_TIMEZONE=Asia/Tashkent

# AI Agent — kunlik so'rov limiti va voice xabar maksimal hajmi (MB)
MODEL_NAME=gemini-flash-latest
AI_DAILY_LIMIT=50
AI_DAILY_LIMIT_FREE=50
AI_DAILY_LIMIT_PRO=500

# Yandex Geocoder — manzil qidirish/aniqlash (order yaratishda)
API_YANDEX_KEY=

# Self-hosted OSRM — marshrut/masofa hisoblash (Docker tarmog'ida "osrm" xizmati nomi)
OSRM_BASE_URL=http://osrm:5000

# ── Frontend portlari (docker-compose) ──────────────────────────────────────
# Dev: Vite dev server + HMR (docker-compose.yml) → `make fe`
FRONTEND_DEV_PORT=5173
# Prod: nginx + statik dist (docker-compose.prod.yml) → `make prod-up`
FRONTEND_PORT=8080
# Prod build'ga "quyiladigan" API manzili (Vite env'lari runtime'da o'qilmaydi).
# `/api` — nginx uni backendga proxy qiladi, frontend+API bitta origin'da bo'ladi.
VITE_API_BASE_URL=/api
