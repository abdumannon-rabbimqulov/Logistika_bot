BOT_TOKEN=your_telegram_bot_token
API_KEY=
SECRET_KEY=change_me_to_a_long_random_secret
DB_USER=postgres
DB_PASSWORD=change_me_strong_password
DB_NAME=logistika_db
DB_HOST=db
DB_PORT=5432
DB_URL=postgresql+asyncpg://postgres:change_me_strong_password@db:5432/logistika_db
# Telegram Web App (HTTPS)
WEBAPP_URL=https://example.org
# Postman / tashqi API (serverdagi nginx /api/ prefiksini backendga uzatadi)
API_PUBLIC_PREFIX=/api
# CORS uchun ruxsat etilgan originlar (vergul bilan ajratilgan). Bo'sh bo'lsa WEBAPP_URL ishlatiladi.
CORS_ORIGINS=https://example.org
# Admin Telegram ID(lar) — vergul bilan ajratiladi
ADMIN=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=1
ENVIRONMENT=production
LOG_LEVEL=INFO

# Test: haydovchi buyurtmalar ro'yxatida mashina turi filtrini o'chirish
# RELAX_DRIVER_ORDER_FILTERS=1

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=True

EMAIL_OTP_EXPIRE=120

# Redis (Docker compose service)
REDIS_HOST=logistika-redis
REDIS_PORT=6379
REDIS_DB=2

# ── RabbitMQ (haydovchi qidirish navbati) ────────────────────────────────────
# Xizmat nomi docker-compose tarmog'idagi "rabbitmq". Boshqaruv UI: :15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# Worker bir vaqtda nechta buyurtmani qidiradi (navbat prefetch cheklovi)
DISPATCH_PREFETCH=5

# ── Support (Yordam) mikroservizi ────────────────────────────────────────────
# Alohida baza — mikroserviz asosiy jadvallarga tegmaydi (bitta Postgres
# konteynerida, lekin boshqa DATABASE). Birinchi `up` da `scripts/init-support-db.sh`
# avtomatik yaratadi; volume allaqachon bor bo'lsa qo'lda:
#   docker compose exec db psql -U postgres -c "CREATE DATABASE support_db"
SUPPORT_DB_NAME=support_db
# Tashqi port — http://localhost:8010/docs
SUPPORT_SERVICE_PORT=8010
# Rejalashtirilgan buyurtma uchun qidiruv yuklashdan shuncha soat oldin boshlanadi
DISPATCH_LEAD_HOURS=24
# Sana taqqoslashlari uchun mintaqa (docker-compose'dagi TZ bilan bir xil)
APP_TIMEZONE=Asia/Tashkent

# AI Agent — kunlik so'rov limiti va voice xabar maksimal hajmi (MB)
MODEL_NAME=gemini-flash-latest
AI_DAILY_LIMIT=50
AI_DAILY_LIMIT_FREE=50
AI_DAILY_LIMIT_PRO=500

# Yandex Geocoder — manzil qidirish/aniqlash (order yaratishda)
API_YANDEX_KEY=

# Self-hosted OSRM — marshrut/masofa hisoblash (Docker tarmog'ida "osrm" xizmati nomi)
OSRM_BASE_URL=http://osrm:5000

# ── Frontend portlari (docker-compose) ──────────────────────────────────────
# Dev: Vite dev server + HMR (docker-compose.yml) → `make fe`
FRONTEND_DEV_PORT=5173
# Prod: nginx + statik dist (docker-compose.prod.yml) → `make prod-up`
FRONTEND_PORT=8080
# Prod build'ga "quyiladigan" API manzili (Vite env'lari runtime'da o'qilmaydi).
# `/api` — nginx uni backendga proxy qiladi, frontend+API bitta origin'da bo'ladi.
VITE_API_BASE_URL=/api

# ── Monitoring (docker-compose.monitoring.yml → `make mon-up`) ───────────────
# To'liq qo'llanma: docs/MONITORING.md
#
# Panelda mashina shu nom bilan ko'rinadi
MONITORING_HOSTNAME=logistika-server
# Portlar — FAQAT 127.0.0.1 ga bog'lanadi, kirish SSH tunnel orqali
NETDATA_PORT=19999
DOCKGE_PORT=5002
DOCKGE_STACKS_DIR=/opt/stacks
# Ilova tarmog'i nomi. Odatda `<papka nomi>_default`. Tekshirish: docker network ls
MONITORING_APP_NETWORK=logistika_bot_default
# docker.sock guruhi. Serverda: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Telegram alertlari (konteyner o'chdi, disk to'ldi, navbat o'sdi...).
# Bo'sh qoldirilsa panel baribir ishlaydi, faqat xabar kelmaydi.
# BOT_TOKEN bilan bir xil bo'lishi mumkin, lekin alohida bot tavsiya etiladi.
MONITORING_TG_TOKEN=
MONITORING_TG_CHAT_ID=

# Alert chegaralari
# Kutilayotgan konteynerlar soni (prod: db, redis, rabbitmq, osrm, web, bot,
# dispatch-worker, support, events-worker, frontend = 10)
MONITORING_EXPECTED_CONTAINERS=10
MONITORING_CRITICAL_CONTAINERS=8
# RabbitMQ navbatida kutayotgan xabarlar soni
MONITORING_QUEUE_WARN=50
MONITORING_QUEUE_CRIT=200

# Netdata uchun alohida faqat-o'qish Postgres roli (tavsiya etiladi, docs/MONITORING.md).
# Bo'sh qoldirilsa yuqoridagi DB_USER / DB_PASSWORD ishlatiladi.
NETDATA_PG_USER=
NETDATA_PG_PASSWORD=
# Baza/Redis/RabbitMQ konteynerda EMAS, host mashinada bo'lsa — `host.docker.internal`
NETDATA_PG_HOST=db
NETDATA_REDIS_HOST=logistika-redis
NETDATA_REDIS_PORT=6379
NETDATA_REDIS_PASSWORD=
NETDATA_RABBITMQ_HOST=rabbitmq
