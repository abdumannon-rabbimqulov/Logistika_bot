postgres_data/
# OSRM xarita ma'lumotlari (~1 GB) — web/bot image'iga kerak emas, faqat osrm
# konteyneri uni volume orqali oladi. Bulardan tashqarida qolsa har bir `docker build`
# 1 GB build context'ni bekorga nusxalaydi.
osrm-data/
# `node_modules/` (slashsiz prefiks) FAQAT ildizdagi papkani chiqarib tashlaydi —
# Docker naqshni to'liq nisbiy yo'lga solishtiradi. Shu sababli `Frontend/node_modules`
# (~88 MB) har bir backend `docker build` da build context'ga bekorga yuklanardi.
# `**/` bilan istalgan chuqurlikdagi papka chiqarib tashlanadi.
**/node_modules/
**/dist/
**/build/

# ── Backend image'iga kerak bo'lmagan katta/begona papkalar ──────────────────
# `.claude/` ichida loyihaning to'liq git worktree NUSXASI bor (o'nlab MB) —
# u build context'ga tushsa image ikki marta kattalashadi.
.claude/
# Frontend butunlay alohida image (Frontend/Dockerfile, o'z konteksti bilan).
Frontend/
docs/
tests/
monitoring/
design_handoff_yuk_asosiy_ekranlar/
# Prod'da bu papkaga named volume ulanadi; image ichidagi nusxa baribir yopiladi,
# lekin build context'ni bekorga ~7 MB ga oshiradi.
uploads/
.pytest_cache/
scripts/__pycache__/
