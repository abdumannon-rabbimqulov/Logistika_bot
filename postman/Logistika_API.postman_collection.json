{
	"info": {
		"_postman_id": "logistika-api-collection",
		"name": "Logistika AI API",
		"description": "Logistika platformasi uchun to'liq API kolleksiyasi.\n\nBase URL: `{{baseUrl}}`\n\n## Autentifikatsiya\n- `POST /auth/login` orqali token oling\n- `Authorization: Bearer {{accessToken}}` header bilan so'rov yuboring\n- Token muddati tugasa `POST /auth/refresh` orqali yangilang\n\n## Rollar\n- **guest** — ro'yxatdan o'tmagan\n- **sender** — yuk jo'natuvchi (mijoz)\n- **driver** — haydovchi\n- **admin** — administrator",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"variable": [],
