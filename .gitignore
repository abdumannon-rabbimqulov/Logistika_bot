# OSRM xarita ma'lumotlari (~1 GB) — git'da saqlanmaydi, `scripts/update-osrm-map.sh`
# orqali qayta yuklab olinadi. Qaysi sana ishlatilayotgani VERSION faylida (u kuzatiladi).
osrm-data/*
!osrm-data/VERSION
*.cells
*.osrm
*.osrm.*
# Lokal compose override (dev uchun --reload va h.k.) — serverga tushmasligi kerak.
docker-compose.override.yml

# Monitoring: `.env` dagi parollar bilan to'ldirilgan netdata konfiguratsiyalari.
# Manba shablonlar `monitoring/netdata/` da va ular git'da kuzatiladi; bu papka
# har `make mon-up` da `monitoring/render-config.py` tomonidan qayta yaratiladi.
monitoring/.rendered/
