# syntax=docker/dockerfile:1
# ── Ishlab chiqish (development) uchun yengil image ─────────────────────────
#
# Konteyner ichida Vite dev serveri ishlaydi, manba kod (`src/`, `public/`) esa host'dan
# bind-mount qilinadi (docker-compose.yml `frontend` xizmati) — faylni saqlash bilanoq
# HMR brauzerda aks etadi.
#
# MUHIM — nima uchun BUTUN papka mount qilinmaydi:
# Ilgari `./Frontend:/app` to'liq mount qilinib, `node_modules` ustiga alohida volume
# qo'yilardi. Docker Desktop (macOS) bind-mount ICHIGA joylashgan volume'ni ishonchli
# "yopmaydi" — konteyner baribir host'dagi `Frontend/node_modules` ni ko'radi. Natijada
# konteyner o'rnatgan linux/musl nativ binarlar (rolldown, oxlint) host'dagi darwin
# binarlarni almashtirib, host'da `npm run build` "Cannot find native binding" bilan
# yiqilardi (va fayllar root egaligida qolardi).
#
# Shuning uchun endi faqat `src/` va `public/` mount qilinadi, `node_modules` esa
# to'liq shu image ichida (konteynerning o'z qatlamida) qoladi — host'dagi
# `Frontend/node_modules` mutlaqo mustaqil bo'lib, lokal `npm run dev` / IDE ishlaydi.
#
# Ishlab chiqarish (production) uchun `Dockerfile` (nginx + `npm run build`) ishlatiladi
# — uni `docker-compose.prod.yml` dagi `frontend` xizmati quradi.

# Node 22: vite@8, @vitejs/plugin-react@6 va oxlint@1 uchalasi ham
# `engines: node ^20.19.0 || >=22.12.0` talab qiladi, Node 20 esa EOL.
FROM node:22-alpine

WORKDIR /app

# Bog'liqliklar alohida qatlamda: faqat package*.json o'zgarganda qayta o'rnatiladi.
# BuildKit kesh mount'i npm keshini build'lar orasida saqlaydi — paket qo'shgandan
# keyingi qayta build sekundlar ichida tugaydi.
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

# Qolgan sozlama fayllari (index.html, vite.config.ts, tsconfig*.json, .oxlintrc.json).
# `src/` va `public/` ham ko'chiriladi, lekin ish paytida ular ustiga host'dagi
# papkalar mount qilinadi — ya'ni image nusxasi faqat mount bo'lmaganda ishlatiladi.
# `.dockerignore` node_modules / dist / .env ni chiqarib tashlaydi.
COPY . .

EXPOSE 5173

# `--host 0.0.0.0` — konteyner tashqarisidan (brauzerdan) kirish uchun shart.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
