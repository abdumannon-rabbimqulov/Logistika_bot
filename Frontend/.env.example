# Backend API bazaviy manzili. Docker (nginx) orqali ishga tushirilganda nisbiy "/api"
# ishlatiladi (Frontend/nginx.conf backendga proxy qiladi). Faqat `npm run dev` (Vite
# dev server, proxy yo'q) uchun "http://localhost:8000/api" ga o'zgartiring.
VITE_API_BASE_URL=/api

# Yandex Maps JS API kaliti — xarita interfeysini ko'rsatish uchun (ochiq kod ichida
# ko'rinadi, shuning uchun Yandex konsolida domenga cheklab qo'yish tavsiya etiladi).
VITE_YANDEX_MAPS_API_KEY=

# DIQQAT: FRONTEND_PORT / FRONTEND_DEV_PORT bu yerda EMAS, repo ildizidagi `.env` da
# beriladi — docker-compose fayllari faqat o'sha faylni o'qiydi. Shu fayl esa faqat
# `npm run dev` (Docker'siz) uchun kerak.
